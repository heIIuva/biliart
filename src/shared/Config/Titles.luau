--!strict
-- Shot titles and anti-titles as data (GDD 7.2). Hanzi and names are placeholders until a native
-- speaker checks them. `conditions` test ShotReport fields:
--   minX = v  ->  report.x >= v      maxX = v  ->  report.x <= v      x = v  ->  report.x == v
-- (X is the field name with its first letter capitalized). `predicate` names a function in
-- ShotClassifier for checks that data can't express. Titles need a foul-free shot; anti-titles don't.

export type Kind = "Title" | "Anti" | "Glitch"
export type Tier = "Common" | "Uncommon" | "Rare" | "Epic" | "Legendary"

export type Title = {
	id: string,
	kind: Kind,
	priority: number, -- the matching title with the highest priority wins
	hanzi: string,
	nameKey: string, -- localization key
	rarityTier: Tier,
	spirit: string?, -- spirit that gains progress (phase 6)
	splash: string, -- splash style key
	sound: string, -- Config.Assets.Sounds key (missing = print stub)
	announcer: string, -- announcer line key
	slowMo: boolean,
	cameraShake: number, -- 0..1
	secret: boolean?, -- shown as "???" in the index
	conditions: { [string]: any },
	predicate: string?,
}

